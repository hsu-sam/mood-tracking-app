DATABASE_PASSWORD=your_database_password
DATABASE_USER=your_database_user
PORT=3000
NODE_ENV=

JWT_SECRET=your_jwt_secret_key  
JWT_EXPIRES_IN=your_jwt_expiration_time


EMAIL_FROM=noreply@your-authenticated-domain.example
CLIENT_URL=https://your-deployed-frontend.example
# Optional extra CORS origins, comma-separated (e.g. local dev while hitting the deployed API)
CORS_ORIGINS=http://localhost:5173

SENDGRID_PASSWORD=your_sendgrid_api_key