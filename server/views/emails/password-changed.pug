doctype html
html(lang='en')
  head
    meta(charset='utf-8')
    meta(name='viewport' content='width=device-width, initial-scale=1')
    title= subject
    include _style.pug
  body
    main.card
      h1 Your password has been reset
      if fullName
        p Hi #{fullName},
      else
        p Hello,
      p Your Mood Tracker password was successfully reset. You can now log in using your new password.
      a.button(href=url) Log in to Mood Tracker
      p.muted If you did not reset your password, please contact support and secure your account.
