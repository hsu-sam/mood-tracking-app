style.
  body {
    margin: 0;
    padding: 24px;
    background: #f4f4f0;
    color: #242424;
    font-family: Arial, Helvetica, sans-serif;
  }
  .card {
    max-width: 560px;
    margin: 0 auto;
    padding: 32px;
    background: #ffffff;
    border-radius: 12px;
  }
  .button {
    display: inline-block;
    margin: 16px 0;
    padding: 12px 20px;
    border-radius: 8px;
    background: #315f52;
    color: #ffffff !important;
    text-decoration: none;
  }
  .muted {
    color: #666666;
    font-size: 14px;
  }