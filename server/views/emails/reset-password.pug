doctype html
html(lang='en')
  head
    meta(charset='utf-8')
    meta(name='viewport' content='width=device-width, initial-scale=1')
    title= subject
    include _style.pug
  body
    main.card
      h1 Reset your password
      if fullName
        p Hi #{fullName},
      else
        p Hello,
      p We received a request to reset the password for your Mood Tracker account. Use the link below to choose a new password. The link expires in 15 minutes.
      a.button(href=url) Reset password
      p If you did not request a password reset, you can ignore this email. Your password will not change.
      p.muted For your security, do not forward this email or share the reset link.
